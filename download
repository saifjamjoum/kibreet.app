<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download Kibreet</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f7f9fc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
        }

        .container {
            background: white;
            padding: 45px 30px;
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        img {
            width: 90px;
            height: 90px;
            border-radius: 20px;
            margin-bottom: 20px;
        }

        h1 {
            margin-bottom: 10px;
            font-size: 30px;
        }

        p {
            color: #666;
            font-size: 17px;
            margin-bottom: 30px;
        }

        .button {
            display: block;
            padding: 15px;
            margin: 12px 0;
            border-radius: 10px;
            text-decoration: none;
            font-size: 17px;
            font-weight: bold;
        }

        .apple {
            background: #000;
            color: white;
        }

        .android {
            background: #34a853;
            color: white;
        }

        .button:hover {
            opacity: 0.9;
        }
    </style>
</head>

<body>

<div class="container">

    <img src="../logo.png" alt="Kibreet Logo">

    <h1>Download Kibreet</h1>

    <p>Download the Kibreet app and get started today.</p>

    <a class="button apple"
       href="YOUR_APP_STORE_LINK"
       target="_blank">
        Download Kibreet on the App Store
    </a>

    <a class="button android"
       href="https://play.google.com/store/apps/details?id=com.bluematchapp"
       target="_blank">
        Get Kibreet on Google Play
    </a>

</div>

</body>
</html>
